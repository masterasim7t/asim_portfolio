/* Rubber / gooey navigation — plain CSS, no React needed */
.rubber-nav {
  --rn-pill: #f4f4f5;
  --rn-ink: rgba(244, 244, 245, 0.7);
  --rn-ink-active: #18161d;
  position: relative;
  display: inline-block;
  padding: 6px;
  border-radius: 999px;
  background: rgba(38, 35, 46, 0.66);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 20px 40px -20px rgba(0, 0, 0, 0.8);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}

.rubber-nav__list {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.rubber-nav__link {
  display: block;
  padding: 9px 16px;
  border-radius: 999px;
  color: var(--rn-ink);
  font: 500 14px/1.2 system-ui, sans-serif;
  text-decoration: none;
  white-space: nowrap;
  transition: color 0.25s ease;
}

.rubber-nav__link:hover { color: #fff; }
.rubber-nav__link.is-active { color: var(--rn-ink-active); }
.rubber-nav__link:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

/* The goo layer sits behind the links; the filter merges pill + droplets */
.rubber-nav__goo {
  position: absolute;
  inset: 0;
  z-index: 1;
  filter: url(#rubber-goo);
  pointer-events: none;
}

.rubber-nav__pill,
.rubber-nav__drop {
  position: absolute;
  background: var(--rn-pill);
  border-radius: 999px;
}

.rubber-nav__pill {
  top: 6px;
  height: calc(100% - 12px);
  transition:
    left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
    width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (prefers-reduced-motion: reduce) {
  .rubber-nav__pill { transition: none; }
}
