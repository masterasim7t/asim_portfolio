
/* Gooey navigation */
.rubber-nav {
  --rn-pill: #f4f4f5;
  --rn-ink: rgba(244, 244, 245, 0.7);
  --rn-ink-active: #18161d;

  position: relative;
  display: inline-block;
  padding: 6px;
  border-radius: 999px;
  background: rgba(38, 35, 46, 0.66);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.08),
    0 20px 40px -20px rgba(0,0,0,.8);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.rubber-nav__list {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.rubber-nav__link {
  display: block;
  padding: 9px 16px;
  border-radius: 999px;
  color: var(--rn-ink);
  font: 500 14px/1.2 system-ui, sans-serif;
  text-decoration: none;
  white-space: nowrap;
  transition: color .25s ease;
  cursor: pointer;
}

.rubber-nav__link:hover {
  color: #fff;
}

.rubber-nav__link.is-active {
  color: var(--rn-ink-active);
}

.rubber-nav__goo {
  position: absolute;
  inset: 0;
  z-index: 1;
  filter: url(#rubber-goo);
  pointer-events: none;
}

.rubber-nav__pill,
.rubber-nav__drop {
  position: absolute;
  background: var(--rn-pill);
  border-radius: 999px;
}

.rubber-nav__pill {
  top: 6px;
  height: calc(100% - 12px);
  transition:
    left .45s cubic-bezier(.34,1.56,.64,1),
    width .45s cubic-bezier(.34,1.56,.64,1);
}

.rubber-nav__drop {
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .rubber-nav__pill {
    transition: none;
  }
}

@media (min-width: 769px) {
  .site-header {
    display: grid !important;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .site-header .brand {
    justify-self: start;
  }

  .site-header nav.desktop-nav.rubber-nav {
    display: inline-flex !important;
    position: relative;
    justify-self: center;
    align-items: center;
    width: max-content;
    max-width: 100%;
  }

  .site-header .desktop-nav .rubber-nav__list {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: max-content;
    margin: 0 !important;
    padding: 0 !important;
  }

  .site-header .desktop-nav .rubber-nav__list li {
    display: flex !important;
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
  }

  .site-header .desktop-nav .rubber-nav__link {
    display: inline-flex !important;
    align-items: center;
    white-space: nowrap;
  }

  .site-header .header-actions {
    justify-self: end;
  }
}
